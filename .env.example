# Near & Now Delivery Partner app — only EXPO_PUBLIC_* variables are read.
# Everything prefixed EXPO_PUBLIC_ is baked into the app bundle: never put a
# secret here. Backend-only secrets (Twilio, Razorpay, service keys) belong in
# the backend's own environment, not in this file.

EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional
# Kind of build. "preview" includes the developer tools (hidden until the build
# number is tapped 7 times). Release builds ignore this and are production
# unless built with --env=preview (local) or the EAS "preview" profile.
# EXPO_PUBLIC_ENV=development
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_API_PROXY_TARGET=http://127.0.0.1:3000
# EAS_PROJECT_ID=
